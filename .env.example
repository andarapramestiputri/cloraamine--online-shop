# Salin berkas ini menjadi .env lalu isi nilainya.

# Port server (opsional, default 4173)
PORT=4173

# Email admin untuk masuk dashboard /admin — WAJIB diganti
ADMIN_EMAIL=admin@cloraamine.test

# Kata sandi admin dashboard /admin — WAJIB diganti (minimal 8 karakter)
ADMIN_PASSWORD=ganti-dengan-kata-sandi-anda

# Nomor WhatsApp penjual (format: 08xxxxxxxxxx) — DATA CONTOH, ganti dengan nomor asli
WA_PENJUAL=081234567890

# Payload QRIS statis dari aplikasi pembayaran Anda — DATA CONTOH
QRIS_PAYLOAD=CONTOH-QRIS-PAYLOAD-SILAKAN-GANTI-MELALUI-ENV
